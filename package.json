{
  "name": "@meristem/client",
  "version": "0.1.0",
  "description": "Meristem Client Agent - Zero-touch node join and management",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "bun dist/index.js",
    "e2e:smoke": "MERISTEM_CORE_URL=http://localhost:3000 MERISTEM_NATS_URL=nats://localhost:4222 bun run src/index.ts"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.2",
    "@insnh-gd/meristem-shared": "npm:@jsr/insnh-gd__meristem-shared@^0.1.0",
    "@iarna/toml": "^2.2.5",
    "pino": "^10.3.0",
    "nats": "^2.29.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
